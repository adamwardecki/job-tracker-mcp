{
  "name": "job-hunt-tracker",
  "version": "0.5.0",
  "description": "Tracker MCP server for the job-hunt plugin. Needs Node 22.18+ (node:sqlite, and it runs its TypeScript directly).",
  "type": "module",
  "private": true,
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "posthog-node": "^5.73.1"
  },
  "bin": {
    "job-hunt-tracker": "src/index.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --no-warnings src/index.ts"
  }
}
