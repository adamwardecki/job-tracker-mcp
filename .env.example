# Usage analytics (only sent after the user opts in during setup). The tracker ships with the project's
# public PostHog token; set these only to point a dev build at another PostHog project.
JOB_TRACKER_POSTHOG_TOKEN=phc_your_project_token
JOB_TRACKER_POSTHOG_HOST=https://us.i.posthog.com
# Stop sending regardless of the opt-in:
# JOB_TRACKER_ANALYTICS=off
